# ============================================================
# Advocate Case Management System — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ---------- Database ----------
DB_URL=jdbc:mysql://localhost:3306/advocate_db
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_SHOW_SQL=false
DB_DDL_AUTO=update

# ---------- JWT ----------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change_me_to_a_random_strong_value
JWT_EXPIRATION_MS=86400000

# ---------- SMTP / Mail ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ---------- Notifications ----------
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SENDER_NAME=Advocate Case Management System

# ---------- WhatsApp Cloud API (Meta) ----------
# Leave blank if not using WhatsApp notifications.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_DEFAULT_LANGUAGE=en_US

# ---------- Twilio WhatsApp (alternate provider) ----------
# Leave blank if using Meta provider or mock.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---------- Document Upload ----------
DOCUMENT_UPLOAD_DIR=uploads

# ---------- OTP ----------
OTP_SALT=change_me_to_a_random_value
OTP_EXPIRY_MINUTES=10
OTP_RATE_LIMIT=5

# ---------- Crypto ----------
# Generate: openssl rand -base64 32
CRYPTO_SECRET_KEY=change_me_to_a_32_byte_base64_key

# ---------- CORS ----------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
